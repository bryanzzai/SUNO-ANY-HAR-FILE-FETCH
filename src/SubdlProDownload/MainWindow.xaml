<Window x:Class="SubdlProDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubDL Subtitle Monitor"
        Height="900"
        Width="1550"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SubDL Subtitle Monitor" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,16" Foreground="DimGray" Text="Scan S01-S15, filter the returned subtitles by release name, tick the rows you want, and save the returned ZIP files."/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Top" Foreground="DimGray" FontSize="11" Text="{Binding ReleaseLabel}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Series title"/>
                <TextBox x:Name="TitleSearchTextBox" Grid.Column="1" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="For example: Justified"/>
                <Button x:Name="SearchTitlesButton" Grid.Column="2" Padding="14,7" Content="Search SubDL" Click="SearchTitlesButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="SubDL title"/>
                <ComboBox x:Name="TitleResultsComboBox" Grid.Column="1" MinHeight="34" Margin="0,0,8,0" ItemsSource="{Binding TitleCandidates}" DisplayMemberPath="DisplayName" ToolTip="Choose the actual TV series from SubDL's results."/>
                <Button x:Name="FindPacksButton" Grid.Column="2" Padding="14,7" Content="Scan S01-S15" Click="FindPacksButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Save ZIPs to"/>
                <TextBox x:Name="OutputFolderTextBox" Grid.Column="1" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="BrowseOutputButton" Grid.Column="2" Padding="14,7" Content="Choose folder…" Click="BrowseOutputButton_Click"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="SubDL Pro API key"/>
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="ApiKeyTextBox" MinHeight="34" VerticalContentAlignment="Center" ToolTip="Paste a replacement API key here. Leave blank to use the saved key."/>
                    <TextBlock Margin="0,4,0,0" Foreground="DimGray" FontSize="11" Text="Up to 100 API rows are retained for each season S01-S15. Package ID, download URL, field details and raw JSON remain retained internally."/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Filter release name"/>
                <TextBox x:Name="ResultsFilterTextBox"
                         Grid.Column="1"
                         MinHeight="34"
                         VerticalContentAlignment="Center"
                         TextChanged="ResultsFilterTextBox_TextChanged"
                         ToolTip="Live free-text filter against release_name only."/>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,0,0,8" Foreground="DimGray" Text="The result grid shows the working fields only. Hidden control and diagnostic data remain attached to each result row for the download flow."/>

        <DataGrid x:Name="SeasonPackGrid" Grid.Row="3" ItemsSource="{Binding RawRowsView}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Download" Width="85" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsRawRow}"
                                      Click="DownloadCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="HI" Binding="{Binding HiDisplay}" Width="45" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="release_name" Binding="{Binding ReleaseName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="season" Binding="{Binding SeasonValue}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="episode" Binding="{Binding EpisodeValue}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Download status" Binding="{Binding DownloadStatus}" Width="220" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Search for a TV series to begin."/>
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="6" Minimum="0" Maximum="15" Value="0"/>
            </StackPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="DimGray" Text="0 rows"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="DownloadButton" Padding="14,6" Margin="0,0,8,0" Content="Download selected ZIPs" Click="DownloadButton_Click" IsEnabled="False"/>
                <Button x:Name="CancelButton" Padding="14,6" Content="Cancel" IsEnabled="False" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
