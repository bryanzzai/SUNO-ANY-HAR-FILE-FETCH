<Window x:Class="SunoHarFileDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SUNO HAR File Download - raw scanner"
        Height="900"
        Width="1800"
        MinHeight="700"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SUNO / ANY HAR FILE FETCH" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="DimGray"
                           Text="RAW DEVELOPMENT VIEW — first 100 HAR entries, no cosmetic filtering, no dedupe, no renaming before download."/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Top"
                       Foreground="DimGray"
                       FontSize="11"
                       Text="{Binding ReleaseLabel}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="HAR file"/>
                <TextBox x:Name="HarFileTextBox" Grid.Column="1" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Padding="14,7" Margin="0,0,8,0" Content="Choose HAR…" Click="BrowseHarButton_Click"/>
                <Button x:Name="ScanButton" Grid.Column="3" Padding="14,7" Content="BORE THROUGH HAR" Click="ScanButton_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Output"/>
                <TextBox x:Name="OutputFolderTextBox" Grid.Column="1" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Padding="14,7" Content="Choose folder…" Click="BrowseOutputButton_Click"/>
            </Grid>
        </StackPanel>

        <DataGrid x:Name="HarGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  EnableRowVirtualization="True"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding EntryIndex}" Width="55" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="GET" Width="55" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanDownload}"
                                      Click="DownloadCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Class" Binding="{Binding Classification}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="HTTP" Binding="{Binding StatusCode}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="MIME" Binding="{Binding MimeType}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="RAW filename" Binding="{Binding RawFileName}" Width="260" IsReadOnly="True"/>
                <DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryMode}" Width="105" IsReadOnly="True"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="500" IsReadOnly="True"/>
                <DataGridTextColumn Header="Diagnostic" Binding="{Binding Diagnostic}" Width="340" IsReadOnly="True"/>
                <DataGridTextColumn Header="Download status" Binding="{Binding DownloadStatus}" Width="220" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Choose a HAR file. Nothing is hidden in the raw development view."/>
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="7" Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
            <TextBlock x:Name="CountTextBlock"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="0 entries"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="DownloadButton"
                        Padding="16,7"
                        Margin="0,0,8,0"
                        Content="DOWNLOAD TICKED"
                        IsEnabled="False"
                        Click="DownloadButton_Click"/>
                <Button x:Name="CancelButton"
                        Padding="16,7"
                        Content="Cancel"
                        IsEnabled="False"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
